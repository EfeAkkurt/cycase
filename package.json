{
  "name": "cycase",
  "private": true,
  "version": "0.1.0",
  "type": "module",
  "description": "CYCASE \u2014 a browser-based cyber incident simulation where a human analyst and an AI agent investigate the same live game state through WebMCP.",
  "license": "MIT",
  "scripts": {
    "dev": "vite",
    "build": "tsc -b && vite build",
    "preview": "vite preview",
    "typecheck": "tsc -b",
    "test": "vitest run",
    "test:watch": "vitest",
    "test:backend": "vitest run tests/backend/unit",
    "test:integration": "vitest run tests/backend/integration tests/backend/load",
    "lint": "eslint .",
    "test:e2e": "playwright test --project=desktop --project=reduced-motion",
    "test:all": "npm run typecheck && npm run lint && vitest run && npm run test:backend && npm run test:integration && npm run test:e2e && npm run test:3d && npm run check:secrets && npm run check:licenses",
    "assets": "node scripts/fetch-assets.mjs",
    "check:secrets": "node scripts/check-secrets.mjs",
    "check:licenses": "node scripts/check-licenses.mjs",
    "check:links": "node scripts/check-links.mjs",
    "test:webmcp:native": "playwright test --project=native-webmcp",
    "dev:server": "tsx watch server/index.ts",
    "start:server": "tsx server/index.ts",
    "db:migrate": "psql \"$DATABASE_URL\" -f server/persistence/schema.sql",
    "test:3d": "playwright test --project=desktop-3d",
    "pretest:e2e": "node scripts/free-test-port.mjs",
    "pretest:3d": "node scripts/free-test-port.mjs",
    "pretest:webmcp:native": "node scripts/free-test-port.mjs"
  },
  "dependencies": {
    "@react-three/fiber": "^9.7.0",
    "@xstate/react": "^5.0.0",
    "fastify": "^5.12.1",
    "react": "^19.1.0",
    "react-dom": "^19.1.0",
    "recharts": "^3.8.0",
    "three": "^0.185.1",
    "xstate": "^5.19.0",
    "zod": "^4.4.3"
  },
  "devDependencies": {
    "@axe-core/playwright": "^4.13.0",
    "@eslint/js": "^10.0.1",
    "@playwright/test": "^1.62.1",
    "@types/node": "^26.4.0",
    "@types/pngjs": "^6.0.5",
    "@types/react": "^19.1.0",
    "@types/react-dom": "^19.1.0",
    "@types/three": "^0.185.4",
    "@vitejs/plugin-react": "^4.3.4",
    "axe-core": "^4.13.0",
    "eslint": "^10.9.1",
    "eslint-plugin-react-hooks": "^7.1.1",
    "fake-indexeddb": "^6.2.5",
    "globals": "^17.11.0",
    "pngjs": "^7.0.0",
    "sharp": "^0.35.4",
    "tsx": "^4.23.12",
    "typescript": "^5.7.3",
    "typescript-eslint": "^8.68.0",
    "vite": "^6.0.7",
    "vitest": "^3.2.7"
  },
  "optionalDependencies": {
    "pg": "^8.23.0"
  },
  "engines": {
    "node": ">=20 <21"
  }
}
