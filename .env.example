# CYCASE environment — VARIABLE NAMES ONLY.
#
# Copy to `.env` and fill in locally. Never commit a filled copy, and never put
# a real value in this file: it is checked in, and a value here is a leaked
# secret the moment it is written.
#
# The browser needs exactly one of these (VITE_CYCASE_BACKEND_URL). Everything
# else is server-side and must never appear in the client bundle — see
# docs/BACKEND_SETUP.md for the grep that proves it.

# ---------------------------------------------------------------------------
# Browser (Vite). Only VITE_-prefixed names reach the client bundle.
# ---------------------------------------------------------------------------

# Base URL of the CYCASE backend, e.g. https://api.cycase.example
# LEAVE THIS UNSET for local mode. Unset means the game makes ZERO backend
# requests and remains fully playable — which is the default and the contract's
# first definition-of-done bullet.
VITE_CYCASE_BACKEND_URL=

# ---------------------------------------------------------------------------
# Server — process
# ---------------------------------------------------------------------------

# Listen address. Defaults to 127.0.0.1; set 0.0.0.0 in a container.
CYCASE_HOST=
# Listen port. Defaults to 8787. Most hosts inject PORT instead.
CYCASE_PORT=
PORT=
# Git SHA reported by GET /api/v1/health. Set this in CI.
BUILD_SHA=
# Silences structured logs. Set automatically when NODE_ENV=test.
CYCASE_QUIET=

# ---------------------------------------------------------------------------
# Server — persistence
# ---------------------------------------------------------------------------

# PostgreSQL connection string. Unset means the in-memory repository, which is
# fine for local development and loses every run on restart.
# Apply server/persistence/schema.sql before first use: npm run db:migrate
DATABASE_URL=

# ---------------------------------------------------------------------------
# Server — security
# ---------------------------------------------------------------------------

# Comma-separated exact origins allowed to call the API.
# Example shape (not a value to copy): https://app.example,https://staging.example
# Never "*": the API sets Access-Control-Allow-Credentials, and the two are
# incompatible.
CYCASE_CORS_ORIGINS=

# Require an allowlisted Origin on every mutation. Defaults to true. Only turn
# this off for a non-browser integration you control.
CYCASE_REQUIRE_ORIGIN=

# Rate limits. Run creation and command append have SEPARATE budgets on purpose:
# creating runs is rare, appending commands happens once per player action.
CYCASE_RATE_RUN_CREATE=
CYCASE_RATE_RUN_CREATE_WINDOW_MS=
CYCASE_RATE_COMMAND_APPEND=
CYCASE_RATE_COMMAND_APPEND_WINDOW_MS=
CYCASE_RATE_SCENARIO_GENERATE=
CYCASE_RATE_SCENARIO_GENERATE_WINDOW_MS=

# ---------------------------------------------------------------------------
# Server — optional features (both default OFF)
# ---------------------------------------------------------------------------

# Server-sent telemetry. Off unless set. The deterministic local adapter runs in
# the browser and needs no server, so leaving this off costs nothing.
CYCASE_FEATURE_SSE=

# Scenario generation. NOT SHIPPED in this build: POST /api/v1/scenarios/generate
# always answers NOT_FOUND. The ScenarioPlan schema and its validation gates do
# ship. This name and the one below are listed so a future deployment has the
# contract in front of it; setting them today changes nothing.
CYCASE_FEATURE_SCENARIO_GENERATION=

# Server-side only. Must never be exposed to the browser, never logged, and
# never interpolated into a prompt that carries scenario or artifact text.
OPENAI_API_KEY=
